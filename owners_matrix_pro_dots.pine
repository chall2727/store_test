wyckoffRangeLen     = input.int(55, "Wyckoff Range Length", minval=20, maxval=300, group=groupMatrix)
wyckoffTrendLen     = input.int(34, "Wyckoff Trend Length", minval=5, maxval=200, group=groupMatrix)
