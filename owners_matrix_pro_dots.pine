// GROUPS
//-----------------------------------------------------------------------------
groupWT       = "WAVETREND SETTINGS"
groupMFI      = "MFI SETTINGS"
groupRSI      = "RSI SETTINGS"
groupSTOCH    = "STOCH SETTINGS"
groupSCH      = "SCHAFF SETTINGS"
groupSOMMI    = "SOMMI SETTINGS"
groupMACD     = "MACD SETTINGS"
groupMode     = "MODE SETTINGS"
groupColor    = "COLOR SETTINGS"
groupAmp      = "WAVE AMPLITUDE"
groupVol      = "RELATIVE VOLUME"
groupADX      = "ADX / CONTROL"
groupMatrix   = "OWNERS MATRIX TABLE"
groupWebhook  = "DISCORD WEBHOOK ALERTS"

