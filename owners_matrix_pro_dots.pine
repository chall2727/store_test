wtChannelLen        = input.int(9, "WT Channel Length", minval=1, group=groupWT)
wtAverageLen        = input.int(12, "WT Average Length", minval=1, group=groupWT)
wtMASource          = input.source(hlc3, "WT MA Source", group=groupWT)
wtMALen             = input.int(3, "WT MA Length", minval=1, group=groupWT)

wtOB1               = input.float(53.0, "WT Overbought Level 1", group=groupWT)
wtOB2               = input.float(60.0, "WT Overbought Level 2", group=groupWT)
wtOB3               = input.float(100.0, "WT Overbought Level 3", group=groupWT)

wtOS1               = input.float(-53.0, "WT Oversold Level 1", group=groupWT)
wtOS2               = input.float(-40.0, "WT Oversold Level 2", group=groupWT)
